# Sentry DSN — get it from https://sentry.io → Project Settings → Client Keys
# Leave empty to disable Sentry (safe for local development)
VITE_SENTRY_DSN=

# PostHog — get it from https://us.posthog.com → Project Settings → API Keys
# Leave empty to disable analytics (rage/dead click tracking won't run)
VITE_POSTHOG_KEY=
# Optional: override the PostHog ingest host (defaults to https://us.i.posthog.com)
VITE_POSTHOG_HOST=
